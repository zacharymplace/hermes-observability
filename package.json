{
  "name": "hermes-observability",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "trace:smoke": "node scripts/trace-smoke.js",
    "check": "npm run standards:check && npm run standards:shape && npm run standard:report && npm run standard:report:json && npm run standard:export && npm run standard:verify-export && npm run hermes:readiness && npm run test:readiness && npm run test:readiness:module && npm run readiness:package:check && npm run test:readiness:package",
    "standards:check": "node scripts/check-standards.js",
    "ci:summary": "bash scripts/github-ci-summary.sh",
    "hermes:observe": "npm run check && npm run trace:smoke && npm run ci:summary",
    "standards:shape": "node scripts/validate-standards-shape.js",
    "standard:report": "node scripts/standard-report.js",
    "standard:report:json": "node scripts/standard-report.js --json",
    "standard:export": "node scripts/standard-export.js",
    "standard:verify-export": "node scripts/verify-standard-export.js",
    "langfuse:doctor": "node scripts/langfuse-doctor.js",
    "ecosystem:audit": "node scripts/ecosystem-audit.js",
    "ecosystem:gate": "npm run standard:export && npm run ecosystem:audit",
    "ecosystem:report": "npm run standard:export && node scripts/ecosystem-report.js",
    "ecosystem:dashboard": "npm run ecosystem:report",
    "ecosystem:full": "npm run ecosystem:gate && npm run ecosystem:dashboard",
    "hermes:readiness": "node scripts/hermes-readiness.js",
    "test:readiness": "node tests/readiness/validator.test.cjs",
    "test:readiness:module": "node tests/readiness/module.test.cjs",
    "readiness:drift": "node scripts/readiness-drift-audit.js",
    "readiness:package:smoke": "node packages/readiness/bin/hermes-readiness.cjs",
    "readiness:package:check": "npm run readiness:package:smoke",
    "test:readiness:package": "node tests/readiness/package-cli.test.cjs"
  },
  "dependencies": {
    "langfuse": "latest"
  }
}
